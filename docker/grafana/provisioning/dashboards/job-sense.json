          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efu0bzagddssgd"
                      },
                      "spec": {
                        "dataset": "aggregator-db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  $__timeGroup(created_at, $TimeGroup) as time,\n  SUM(\n    (attributes->'llm_usage'->'input_tokens')::BIGINT * 0.75 * 0.000001 +\n    (attributes->'llm_usage'->'output_tokens')::BIGINT * 4.50 * 0.000001\n  ) as cost\nFROM messages\nWHERE created_at BETWEEN $__timeFrom() AND $__timeTo()\n  AND attributes->'llm_usage' IS NOT NULL\nGROUP BY 1\nORDER BY 1",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
