TELEGRAM_TOKEN=

OPENAI_TOKEN=
OPENAI_MODEL=

BRIGHT_DATA_TOKEN=

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Read by dbmate. One URL rather than parts, because interpolating a
# password with special characters into one is fragile. In the compose
# stack the host is the postgres service name.
DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?sslmode=disable

GRAFANA_ADMIN_PASSWORD=
